// Naive version: no mem access optimization, no border handling
// AIE window interface is 256 bits, so for int32 type we can use maximum 8 lanes. 8x32b = 256b

static mut ch1 : channel8[i32];
static mut ch2 : channel8[i32];
static mut ch3 : channel8[i32];
static mut ch4 : channel8[i32];

#[export]
fn main() -> () {
    let device = 0;

    let img_dim = Img_dim { width = 1024, height = 1024 };
    let mask = get_mask5(mask5);
    let kernel_width = mask.size_x;
    let kernel_height = mask.size_y;

    let flat_mask = FlatMask5[DATA_TYPE] {
                        row0 = $guassian_coeffs_row0,
                        row1 = $guassian_coeffs_row1,
                        row2 = $guassian_coeffs_row2,
                        row3 = $guassian_coeffs_row3,
                        row4 = $guassian_coeffs_row4,
                        size = $kernel_width
                    };


    let auto_locate = (-1, -1);
    let core_config = Config{device = 0, runtime_ratio = 1, location = auto_locate, vector_size = v_size, interface = Interface::window};

    let fpga = Core::FPGA(core_config.device);
    let cgra = Core::CGRA(core_config);
    let fpga_math = get_core_intrinsics(fpga);
    let cgra_math = get_core_intrinsics(cgra);

    let arr       = alloc_cpu((img_dim.width * img_dim.height) as i64 * sizeof[DATA_TYPE]());
    let out       = alloc_cpu((img_dim.width * img_dim.height) as i64 * sizeof[DATA_TYPE]());
    let arr_fpga = alloc_device(fpga, (img_dim.width * img_dim.height) as i64 * sizeof[DATA_TYPE]());
    let out_fpga = alloc_device(fpga, (img_dim.width * img_dim.height) as i64 * sizeof[DATA_TYPE]());


    // initialize host buffers
    for i in range(0, img_dim.width * img_dim.height) {
        let arr_ptr = bitcast[&mut[DATA_TYPE]](arr.data);
        let out_ptr = bitcast[&mut[DATA_TYPE]](out.data);
        arr_ptr(i) = i as DATA_TYPE;
        out_ptr(i) = 0:DATA_TYPE;

    }

    //let process = process5[DATA_TYPE];
    //let process = process5_flat[DATA_TYPE]; /* stream interface */
    let process = process5_flat_window[DATA_TYPE]; /* window interface */
    let prepare_lbuff = prepare_lbuff5_window[DATA_TYPE]; /* window interface */
    //let prepare_lbuff = prepare_lbuff5[DATA_TYPE]; /* stream interface */

    for benchmark_host(num_host_iter) {
        // copy from host to fpga
        copy(arr, arr_fpga);

        // read from fpga memory and write to channel
        for x, y, _reserved, _lbuff in iteration_core[DATA_TYPE](fpga, img_dim, mask) {
            let idx = y * (img_dim.width / v_size) + x;
            write_channel8[DATA_TYPE](&mut ch1, read(arr_fpga, idx));
        }

        for _x, y, _reserved, lbuff in iteration_core[DATA_TYPE](cgra, img_dim, mask) {

            let lbuff_addrs = @prepare_lbuff(ch1, lbuff, kernel_width, img_dim);
            process(img_dim, lbuff_addrs, flat_mask, &mut ch2);
        }

        for _x, y, _reserved, lbuff in iteration_core[DATA_TYPE](cgra, img_dim, mask) {

            let lbuff_addrs = @prepare_lbuff(ch2, lbuff, kernel_width, img_dim);
            process(img_dim, lbuff_addrs, flat_mask, &mut ch3);
        }

        for _x, y, _reserved ,lbuff in iteration_core[DATA_TYPE](cgra, img_dim, mask) {

            let lbuff_addrs = @prepare_lbuff(ch3, lbuff, kernel_width, img_dim);
            process(img_dim, lbuff_addrs, flat_mask, &mut ch4);
        }

        // read from channel and write to fpga memory
        for x, y, _reserved, _lbuff in iteration_core[DATA_TYPE](fpga, img_dim, mask) {
            let idx = y * (img_dim.width / v_size) + x;
            write(out_fpga, idx, read_channel8[DATA_TYPE](&mut ch4));
        }

        sync_device(fpga);
        // copy back from fpga to host
        copy(out_fpga, out);

    }

    release(out_fpga);
    release(arr_fpga);
    release(arr);
    release(out);

    print_string("Executed!\n");
}

