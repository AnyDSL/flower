// AIE window interface is 256 bits, so for int32 type we can use maximum 8 lanes. 8x32b = 256b

static mut ch_in_to_luma : channel8[pixel_t];
//static mut ch_luma_to_gx : channel8[pixel_t];
//static mut ch_luma_to_gy : channel8[pixel_t];
static mut ch_luma_to_g : channel8[pixel_t];
static mut ch_gx_to_mag  : channel8[pixel_t];
static mut ch_gy_to_mag  : channel8[pixel_t];
static mut ch_mag_to_out : channel8[pixel_t];

#[export]
fn main() -> () {

    let img_dim = Img_dim { width = 1024, height = 1024 };

    let mask_x    = get_mask3(sobel_maskx);
    let mask_y    = get_mask3(sobel_masky);
    let null_mask = null_mask();

    let threshold = 80 as pixel_t;

    let kernel_width  = mask_x.size_x;
    let kernel_height = mask_y.size_y;

    let flat_mask_x = FlatMask3[DATA_TYPE] {
                        row0 = sobel_x_coeffs_row0,
                        row1 = sobel_x_coeffs_row1,
                        row2 = sobel_x_coeffs_row2,
                        size = kernel_width
                    };

    let flat_mask_y = FlatMask3[DATA_TYPE] {
                        row0 = sobel_y_coeffs_row0,
                        row1 = sobel_y_coeffs_row1,
                        row2 = sobel_y_coeffs_row2,
                        size = kernel_width
                    };

    let auto_locate = (-1, -1);
    let core_config = Config{device = 0, runtime_ratio = 1, location = auto_locate, vector_size = v_size, interface = Interface::window};

    let fpga = Core::FPGA(core_config.device);
    let cgra = Core::CGRA(core_config);
    let fpga_math = get_core_intrinsics(fpga);
    let cgra_math = get_core_intrinsics(cgra);

    let arr      = alloc_cpu((img_dim.width * img_dim.height) as i64 * sizeof[DATA_TYPE]());
    let out      = alloc_cpu((img_dim.width * img_dim.height) as i64 * sizeof[DATA_TYPE]());
    let arr_fpga = alloc_device(fpga, (img_dim.width * img_dim.height) as i64 * sizeof[DATA_TYPE]());
    let out_fpga = alloc_device(fpga, (img_dim.width * img_dim.height) as i64 * sizeof[DATA_TYPE]());

    // initialize host buffers
    for i in range(0, img_dim.width * img_dim.height) {
        let arr_ptr = bitcast[&mut[DATA_TYPE]](arr.data);
        let out_ptr = bitcast[&mut[DATA_TYPE]](out.data);

        // simulating a 2D traversal in a linear fashion.
        let x = i % img_dim.width;
        let y = i / img_dim.width;

        let val = if ((((x % 16) >= 8) & (( y % 16) < 8)) | (((x % 16) < 8) & ((y % 16) >= 8))) == false { 255 as pixel_t }
                  else { 0 as pixel_t }; // a checkerboard pattern

        arr_ptr(i) = val as DATA_TYPE;
        out_ptr(i) = 0:DATA_TYPE;
    }

    //let process = process3[DATA_TYPE];
    //let process = process3_flat[DATA_TYPE];
    let process = process3_flat_window[DATA_TYPE];
    let prepare_lbuff = prepare_lbuff3_window[DATA_TYPE];
    //let prepare_lbuff = prepare_lbuff3[DATA_TYPE];

    for benchmark_host(num_host_iter) {
        // copy from host to fpga
        copy(arr, arr_fpga);

        // read from fpga global memory and write to a channel
        for x, y , _lbuff in iteration_core[DATA_TYPE](fpga, img_dim, null_mask) {
            let idx = y * img_dim.width + x;
            let data = read(arr_fpga, idx);
            write_channel8[DATA_TYPE](&mut ch_in_to_luma, data);
        }

        // luma
        for _x, _y, _lbuff in iteration_core[DATA_TYPE](cgra, img_dim, null_mask) {

            let in_to_luma = cgra_window_read_channel_v8[DATA_TYPE](ch_in_to_luma);
            //let in_to_luma = cgra_read_channel_v8[DATA_TYPE](ch_in_to_luma); /* stream interface */

            let byte_mask = cgra_broadcast[DATA_TYPE](v_size, 0xff);

            // exctracting the RGB components by shifting and masking
            let b = cgra_bit_and[DATA_TYPE](in_to_luma, byte_mask);
            let g = cgra_bit_and[DATA_TYPE](cgra_downshift[DATA_TYPE](in_to_luma, 8), byte_mask);
            let r = cgra_bit_and[DATA_TYPE](cgra_downshift[DATA_TYPE](in_to_luma, 16), byte_mask);

            // luma calculation for RGB to YUV conversion
            // note that cgra_mul returns an accumulator,i64,because of that we need to use cgra_add[i64]
            let pix_luma_temp = cgra_add[i64](
                cgra_add[i64](cgra_mul[DATA_TYPE](r, 66), cgra_mul[DATA_TYPE](g, 129)),
                cgra_add[i64](cgra_mul[DATA_TYPE](b, 25), cgra_broadcast[i64](v_size, 128))// adding 128 for rounding
            );

            // division by 256 (shift 8 bits) scales down the result to fit within an 8-bit range (0-255)
            // adding 16 to the result adjusts the result to fit within the standard luma range of 16 to 235.
            let pix_luma = cgra_add[i64](cgra_downshift[i64](pix_luma_temp, 8), cgra_broadcast[i64](v_size, 16));

            // casting accumulator to vector
            let pix_luma_vec = cgra_shift_round_saturate[DATA_TYPE, i64](v_size as u32, pix_luma, ACC_SHIFT);

            // sending to the other stages
            //cgra_window_write_channel_v8(&mut ch_luma_to_gx, pix_luma_vec);
            //cgra_window_write_channel_v8(&mut ch_luma_to_gy, pix_luma_vec);

            cgra_window_write_channel_v8(&mut ch_luma_to_g, pix_luma_vec);
            //cgra_write_channel_v8(&mut ch_luma_to_g, pix_luma_vec); /* stream interface */
        }

        // gx
        for _x, y, lbuff in iteration_core[DATA_TYPE](cgra, img_dim, mask_x) {

            let lbuff_addrs = @prepare_lbuff(ch_luma_to_g, lbuff, kernel_width, img_dim);
            process(img_dim, lbuff_addrs, flat_mask_x, &mut ch_gx_to_mag);
        }
        // gy
        for _x, y, lbuff in iteration_core[DATA_TYPE](cgra, img_dim, mask_y) {

            let lbuff_addrs = @prepare_lbuff(ch_luma_to_g, lbuff, kernel_width, img_dim);
            process(img_dim, lbuff_addrs, flat_mask_y, &mut ch_gy_to_mag);
        }
        // magnitude
        for _x, _y, _lbuff in iteration_core[DATA_TYPE](cgra, img_dim, null_mask) {


            let gx_to_mag = cgra_window_read_channel_v8[DATA_TYPE](ch_gx_to_mag);
            let gy_to_mag = cgra_window_read_channel_v8[DATA_TYPE](ch_gy_to_mag);
            //let gx_to_mag = cgra_read_channel_v8[DATA_TYPE](ch_gx_to_mag); /* stream interface */
            //let gy_to_mag = cgra_read_channel_v8[DATA_TYPE](ch_gy_to_mag); /* stream interface */

            let gx_mag = cgra_abs(gx_to_mag);
            let gy_mag = cgra_abs(gy_to_mag);
            let val =  cgra_add[DATA_TYPE](gx_mag, gy_mag);

            let threshold_vec = cgra_broadcast[DATA_TYPE](v_size, threshold);
            let threshold_mask = cgra_gt[DATA_TYPE](val, threshold_vec);

            // we can also use cgra_select(threshold_mask, 255, 0), then we don't need to use shift_round_saturate
            // because data will stay in vector, not accumulate registers.
            let res = cgra_mul[DATA_TYPE](val, 255);
            let res_vector = cgra_shift_round_saturate[DATA_TYPE, i64](v_size as u32, res, ACC_SHIFT);

            cgra_window_write_channel_v8(&mut ch_mag_to_out, res_vector);
            //cgra_write_channel_v8(&mut ch_mag_to_out, res_vector); /* stream interface */
        }

        // read from channel and write to fpga global memory
        for x, y, _lbuff in iteration_core[DATA_TYPE](fpga, img_dim, null_mask) {
            let idx = y * img_dim.width + x;
            write(out_fpga, idx, read_channel8[DATA_TYPE](&mut ch_mag_to_out));
        }

        sync_device(fpga);
        // copy back from fpga gmem to host
        copy(out_fpga, out);

    }

    // Display the output
    for i in range(0, img_dim.width * img_dim.height) {
        let out_ptr = bitcast[&mut[DATA_TYPE]](out.data);
        print_i32(out_ptr(i) as i32);
        print_string(" ");
    }

    release(out_fpga);
    release(arr_fpga);
    release(arr);
    release(out);

    print_string("Executed!\n");
}
