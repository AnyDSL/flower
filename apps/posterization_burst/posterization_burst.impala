// Naive version: no mem access optimization, no border handling
// AIE window interface is 256 bits, so for int32 type we can use maximum 8 lanes. 8x32b = 256b

static mut ch1 : channel8[i32];
static mut ch2 : channel8[i32];
static mut ch3 : channel8[i32];
static mut ch4 : channel8[i32];


#[export]
fn main() -> () {

    let img_dim = Img_dim { width = 1024, height = 1024 };
    let null_mask = null_mask();

    let auto_locate = (-1, -1);

    let device = 0;
    let fpga = Core::FPGA(device);
    let fpga_math = get_core_intrinsics(fpga);

    let arr       = alloc_cpu((img_dim.width * img_dim.height) as i64 * sizeof[DATA_TYPE]());
    let out       = alloc_cpu((img_dim.width * img_dim.height) as i64 * sizeof[DATA_TYPE]());
    let arr_fpga = alloc_device(fpga, (img_dim.width * img_dim.height) as i64 * sizeof[DATA_TYPE]());
    let out_fpga = alloc_device(fpga, (img_dim.width * img_dim.height) as i64 * sizeof[DATA_TYPE]());

    // initialize host buffers
    for i in range(0, img_dim.width * img_dim.height) {
        let arr_ptr = bitcast[&mut[DATA_TYPE]](arr.data);
        let out_ptr = bitcast[&mut[DATA_TYPE]](out.data);
        arr_ptr(i) = i as DATA_TYPE;
        out_ptr(i) = 0:DATA_TYPE;
    }

    let max_level = 3;

    for benchmark_host(num_host_iter) {
        // copy from host to fpga
        copy(arr, arr_fpga);

        // read from fpga global memory and write to a channel
        for x, y , _reserved, _lbuff in iteration_core[DATA_TYPE](fpga, img_dim, null_mask) {
            let idx = y * (img_dim.width / v_size) + x;
            write_channel8[DATA_TYPE](&mut ch1, read(arr_fpga, idx));
        }

        for _x, _y, _reserved, _lbuff in iteration_core[DATA_TYPE](fpga, img_dim, null_mask) {
            let data_slice = read_channel8[DATA_TYPE](&mut ch1);

            let mut value_vec = bitcast[[DATA_TYPE * 8]]([0; 8]); // v_size = 8
            let mut value = 0;

            for v in unroll(0, v_size - 1) {
                value = data_slice(v) >> 6;
                value_vec(v) = value;
            }

            write_channel8(&mut ch2, value_vec);
        }

        for _x, _y, _reserved, _lbuff in iteration_core[DATA_TYPE](fpga, img_dim, null_mask) {

            let data = read_channel8[DATA_TYPE](&mut ch2);
            let mut value_vec = bitcast[[DATA_TYPE * 8]]([0; 8]); // v_size = 8
            let mut value = 0;

            for v in unroll(0, v_size - 1) {
                value = min(data(v), max_level);
                value_vec(v) = value;
            }

            write_channel8[DATA_TYPE](&mut ch3, value_vec);
        }

        for _x, _y, _reserved, _lbuff in iteration_core[DATA_TYPE](fpga, img_dim, null_mask) {

            let data = read_channel8[DATA_TYPE](&mut ch3);
            let mut value_vec = bitcast[[DATA_TYPE * 8]]([0; 8]); // v_size = 8
            let mut value = 0;

            for v in unroll(0, v_size - 1) {
                value = data(v) * 8;
                value_vec(v) = value;
            }

            write_channel8[DATA_TYPE](&mut ch4, value_vec);

        }

        // read from the channel and write to fpga global memory
        for x, y, _reserved, _lbuff in iteration_core[DATA_TYPE](fpga, img_dim, null_mask) {
            let idx = y * (img_dim.width / v_size)+ x;
            write(out_fpga, idx, read_channel8[DATA_TYPE](&mut ch4));
        }

        sync_device(fpga);
        // copy back from fpga gmem to host
        copy(out_fpga, out);

    }

    fn reference() -> i32 {
        let mut error = 0;
        for i in range(0, img_dim.width * img_dim.height) {
            let arr_ptr = bitcast[&mut[DATA_TYPE]](arr.data);
            let out_ptr = bitcast[&mut[DATA_TYPE]](out.data);
            let expected = arr_ptr(i) * arr_ptr(i);
            if out_ptr(i) != expected {
                error += 1;
            }
        }
        error
    }

    let result = reference();

    release(out_fpga);
    release(arr_fpga);
    release(arr);
    release(out);

    print_string("Executed!\n");
}

