    // cgra tile0 processing the first chunk of data
    for x, y, _chunk_size in iteration(cgra, width, height) {
        let temp0 = cgra_window_read_channel_v8(&mut chan0_fpga_to_cgra);
        cgra_window_write_channel_v8(&mut chan0_cgra_to_fpga, temp0);
    }

    // cgra tile1 processing the second chunk of data
    for x, y, _chunk_size in iteration(cgra, width, height) {
        let temp1 = cgra_window_read_channel_v8(&mut chan1_fpga_to_cgra);
        cgra_window_write_channel_v8(&mut chan1_cgra_to_fpga, temp1);
    }

    // cgra tile2 processing the second chunk of data
    for x, y, _chunk_size in iteration(cgra, width, height) {
        let temp1 = cgra_window_read_channel_v8(&mut chan2_fpga_to_cgra);
        cgra_window_write_channel_v8(&mut chan2_cgra_to_fpga, temp1);
    }

    // cgra tile3 processing the second chunk of data
    for x, y, _chunk_size in iteration(cgra, width, height) {
        let temp1 = cgra_window_read_channel_v8(&mut chan3_fpga_to_cgra);
        cgra_window_write_channel_v8(&mut chan3_cgra_to_fpga, temp1);
    }

    // cgra tile4 processing the second chunk of data
    for x, y, _chunk_size in iteration(cgra, width, height) {
        let temp1 = cgra_window_read_channel_v8(&mut chan4_fpga_to_cgra);
        cgra_window_write_channel_v8(&mut chan4_cgra_to_fpga, temp1);
    }

    // cgra tile5 processing the second chunk of data
    for x, y, _chunk_size in iteration(cgra, width, height) {
        let temp1 = cgra_window_read_channel_v8(&mut chan5_fpga_to_cgra);
        cgra_window_write_channel_v8(&mut chan5_cgra_to_fpga, temp1);
    }

    // cgra tile6 processing the second chunk of data
    for x, y, _chunk_size in iteration(cgra, width, height) {
        let temp1 = cgra_window_read_channel_v8(&mut chan6_fpga_to_cgra);
        cgra_window_write_channel_v8(&mut chan6_cgra_to_fpga, temp1);
    }

    // cgra tile7 processing the second chunk of data
    for x, y, _chunk_size in iteration(cgra, width, height) {
        let temp1 = cgra_window_read_channel_v8(&mut chan7_fpga_to_cgra);
        cgra_window_write_channel_v8(&mut chan7_cgra_to_fpga, temp1);
    }

    // read from channels and write to fpga memory (Gatther)
    for x, y, chunk_size in iteration(fpga, width, height) {

        let mut tile = bitcast[[[DATA_TYPE * 8] * 8]]([0; 64]);

        tile(0) = read_channel8(&mut chan0_cgra_to_fpga);
        tile(1) = read_channel8(&mut chan1_cgra_to_fpga);
        tile(2) = read_channel8(&mut chan2_cgra_to_fpga);
        tile(3) = read_channel8(&mut chan3_cgra_to_fpga);
        tile(4) = read_channel8(&mut chan4_cgra_to_fpga);
        tile(5) = read_channel8(&mut chan5_cgra_to_fpga);
        tile(6) = read_channel8(&mut chan6_cgra_to_fpga);
        tile(7) = read_channel8(&mut chan7_cgra_to_fpga);


        for t in range(0, tile_size) {
            let idx = y * (width / v_size) + (x + t * chunk_size);
            write(out_fpga, idx, tile(t));            // on-chip -> DRAM (local mem to global mem)
        }

    }
