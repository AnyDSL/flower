// one fpga reader/writer data mover kernel to write/read on/from several channels is extreamly slow due to the port congestion
type DATA_TYPE = i32;
static v_size = 8;
static tile_size = 8;

fn @iteration_(body: fn(i32, i32) -> ()) = @|core: Core, width: i32, height: i32| {
    generate(core,||{
        for y in range(0, height) {
            for x in range(0, width / v_size) {
                @body(x, y);
            }
        }

    });
};

fn @alloc_device(core: Core, size: i64) -> Buffer {
    get_core_backend(core).alloc(size)
}

fn @sync_device(core: Core) -> () {
    let device = get_core_backend(core);
    device.sync()
}


fn @iteration_stream(body: fn(i32, i32) -> ()) = @|core: Core, width: i32, height: i32| {
    generate(core,||{
                @body(1, 1);
    });

};


fn @iteration(body: fn(i32, i32, i32) -> ()) = @|core: Core, width: i32, height: i32| {

    let vectors_per_row = width / v_size;
    //let total_vectors = vectors_per_row * height;
    let chunk_size = vectors_per_row / tile_size;

    match core {
        Core::FPGA(_) => {

            generate(core,||{
                for y in range(0, height) {
                    for x in pipeline(0, 0, chunk_size) {
                        @body(x, y, chunk_size);
                    }
                }
            });
        },
        Core::CGRA(config) => {
            match config.interface {
                Interface::stream => {
                    generate(core,||{
                        @body(1, 1, 0);
                    });
                },
                _ => {

                    generate(core,||{
                        for y in range(0, height) {
                            for x in pipeline(0, 0, chunk_size) {
                                @body(x, y, 0);
                            }
                        }
                    });
                }
            }
        },
        _ => ()
    }
};


fn @read(buf: Buffer, i: i32) -> [DATA_TYPE * 8] { bitcast[&addrspace(1)[[DATA_TYPE * 8]]](buf.data)(i) }
fn @write(buf: Buffer, i: i32, v: [DATA_TYPE * 8]) -> () { bitcast[&mut addrspace(1)[[DATA_TYPE * 8]]](buf.data)(i) = v }

static mut chan0_fpga_to_cgra: channel8[DATA_TYPE];
static mut chan1_fpga_to_cgra: channel8[DATA_TYPE];
static mut chan2_fpga_to_cgra: channel8[DATA_TYPE];
static mut chan3_fpga_to_cgra: channel8[DATA_TYPE];
static mut chan4_fpga_to_cgra: channel8[DATA_TYPE];
static mut chan5_fpga_to_cgra: channel8[DATA_TYPE];
static mut chan6_fpga_to_cgra: channel8[DATA_TYPE];
static mut chan7_fpga_to_cgra: channel8[DATA_TYPE];
static mut chan8_fpga_to_cgra: channel8[DATA_TYPE];
static mut chan9_fpga_to_cgra: channel8[DATA_TYPE];

static mut chan0_cgra_to_fpga: channel8[DATA_TYPE];
static mut chan1_cgra_to_fpga: channel8[DATA_TYPE];
static mut chan2_cgra_to_fpga: channel8[DATA_TYPE];
static mut chan3_cgra_to_fpga: channel8[DATA_TYPE];
static mut chan4_cgra_to_fpga: channel8[DATA_TYPE];
static mut chan5_cgra_to_fpga: channel8[DATA_TYPE];
static mut chan6_cgra_to_fpga: channel8[DATA_TYPE];
static mut chan7_cgra_to_fpga: channel8[DATA_TYPE];
static mut chan8_cgra_to_fpga: channel8[DATA_TYPE];
static mut chan9_cgra_to_fpga: channel8[DATA_TYPE];

#[export]
fn main() -> i32 {

    let width   = 2048;
    let height  = 2048;

    let core_config = Config{device = 0, runtime_ratio = 1, location = (-1,-1), vector_size = v_size, interface = Interface::window};

    let fpga = Core::FPGA(core_config.device);
    let cgra = Core::CGRA(core_config);

    let fpga_math = get_core_intrinsics(fpga);
    let cgra_math = get_core_intrinsics(cgra);

    let arr       = alloc_cpu((width * height) as i64 * sizeof[DATA_TYPE]());
    let out       = alloc_cpu((width * height) as i64 * sizeof[DATA_TYPE]());
    let arr_fpga = alloc_device(fpga, (width * height) as i64 * sizeof[DATA_TYPE]());
    let out_fpga = alloc_device(fpga, (width * height) as i64 * sizeof[DATA_TYPE]());

    // initialize host buffers
    for i in range(0, width * height) {
        let arr_ptr = bitcast[&mut[DATA_TYPE]](arr.data);
        let out_ptr = bitcast[&mut[DATA_TYPE]](out.data);
        arr_ptr(i) = i as DATA_TYPE;
        out_ptr(i) = 0:DATA_TYPE;
    }

    // copy from host to fpga
    copy(arr, arr_fpga);

    // read from fpga memory and write to channels (Scatter)
    for x, y, chunk_size in iteration(fpga, width, height) {
        let mut tile = bitcast[[[DATA_TYPE * 8] * 8]]([0; 64]);

        for t in range(0, tile_size) {
            let idx = y * (width / v_size) + (x + t * chunk_size);
            tile(t) = read(arr_fpga, idx);            // DRAM -> on-chip
        }

        // tile can be added as a layer of a nested-loop in the iteration function
        write_channel8(&mut chan0_fpga_to_cgra, tile(0) );
        write_channel8(&mut chan1_fpga_to_cgra, tile(1));
        write_channel8(&mut chan2_fpga_to_cgra, tile(2));
        write_channel8(&mut chan3_fpga_to_cgra, tile(3));
        write_channel8(&mut chan4_fpga_to_cgra, tile(4) );
        write_channel8(&mut chan5_fpga_to_cgra, tile(5));
        write_channel8(&mut chan6_fpga_to_cgra, tile(6));
        write_channel8(&mut chan7_fpga_to_cgra, tile(7));
    }


//// read from fpga memory and write to channels (Scatter)
