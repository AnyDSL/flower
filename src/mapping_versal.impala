
type DATA_TYPE = i32;

// custom types for flat masks
struct FlatMask3[T] {
    row0: [T * 8],
    row1: [T * 8],
    row2: [T * 8],
    size: i32,
}

struct FlatMask5[T] {
    row0: [T * 8],
    row1: [T * 8],
    row2: [T * 8],
    row3: [T * 8],
    row4: [T * 8],
    size: i32,
}

static v_size = 8;
static mut lbuf_cnt = 0;

static ACC_SHIFT = 1:u32; // set for i32 8x8 sliding window

fn @aie_pipeline(body: fn (i32) -> ()) = @|lower: i32, upper: i32| thorin_pipeline(0, lower, upper, body);

fn @sync_device(core: Core) -> () {
    let device = get_core_backend(core);
    device.sync()
}

// for FIR1D with index flattening
fn @iteration_(body: fn(i32, i32) -> ()) = @|core: Core, width: i32, height: i32| {
    match core {
        Core::FPGA(_) => {

            generate(core,||{
                for y in range(0, height) {
                    for x in pipeline(0, 0, width) {
                        @body(x, y);
                    }
                }
            });
        },
        Core::CGRA(config) => {
            match config.interface {
                Interface::stream => {
                    generate(core,||{
                        @body(1, 1);
                    });
                },
                _ => {
                    generate(core,||{
                        for y in range(0, height / v_size) {
                            for x in aie_pipeline(0, width / v_size) {
                                @body(x, y);
                            }
                        }
                    });
                }
            }
        },
        _ => ()
    }
};


    // for mask 3x3
    fn @prepare_lbuff3_window[T](input: &mut channel8[T], lbuff: &mut addrspace(3)[T], kernel_width: i32, img_dim: Img_dim) -> Linebuffer_t[fn(i32) -> &mut addrspace(3) T] {
        let lbuf_seg = lbuf_cnt % kernel_width;

        for x in aie_pipeline(0, img_dim.width / v_size) {
            //let data_slice = read_channel_v8[T](input);
            let data_slice = cgra_window_read_channel_v8[T](input);
            let lbuff_idx = (lbuf_seg * img_dim.width) + (x * v_size);
            cgra_store_v_local[T](lbuff(lbuff_idx), data_slice);
        }

        let cur_lbuf_cnt = lbuf_cnt;
        lbuf_cnt++;

        if cur_lbuf_cnt == 0 {

            Linebuffer_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(i) },
            }

        } else if cur_lbuf_cnt == 1 {

            Linebuffer_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(img_dim.width + i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(img_dim.width + i) },
            }

        } else {

            Linebuffer_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 1) % kernel_width) * img_dim.width + i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 2) % kernel_width) * img_dim.width + i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 0) % kernel_width) * img_dim.width + i) },
            }
        }
    }


    // for mask 3x3
    fn @prepare_lbuff3[T](input: &mut channel8[T], lbuff: &mut addrspace(3)[T], kernel_width: i32, img_dim: Img_dim) -> Linebuffer_t[fn(i32) -> &mut addrspace(3) T] {
        let lbuf_seg = lbuf_cnt % kernel_width;

        for x in aie_pipeline(0, img_dim.width / v_size) {
            //let data_slice = read_channel_v8[T](input);
            let data_slice = cgra_read_channel_v8[T](input);
            let lbuff_idx = (lbuf_seg * img_dim.width) + (x * v_size);
            cgra_store_v_local[T](lbuff(lbuff_idx), data_slice);
        }

        let cur_lbuf_cnt = lbuf_cnt;
        lbuf_cnt++;

        if cur_lbuf_cnt == 0 {

            Linebuffer_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(i) },
            }

        } else if cur_lbuf_cnt == 1 {

            Linebuffer_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(img_dim.width + i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(img_dim.width + i) },
            }

        } else {

            Linebuffer_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 1) % kernel_width) * img_dim.width + i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 2) % kernel_width) * img_dim.width + i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 0) % kernel_width) * img_dim.width + i) },
            }
        }
    }



    fn @prepare_lbuff5_window[T](input: &mut channel8[T], lbuff: &mut addrspace(3)[T], kernel_width: i32, img_dim: Img_dim) -> Linebuffer5_t[fn(i32) -> &mut addrspace(3) T] {
        let lbuf_seg = lbuf_cnt % kernel_width;

        for x in aie_pipeline(0, img_dim.width / v_size) {
            //let data_slice = read_channel_v8[T](input);
            let data_slice = cgra_window_read_channel_v8[T](input);
            let lbuff_idx = (lbuf_seg * img_dim.width) + (x * v_size);
            cgra_store_v_local[T](lbuff(lbuff_idx), data_slice);
        }

        let cur_lbuf_cnt = lbuf_cnt;
        lbuf_cnt++;

        if cur_lbuf_cnt == 0 {

            Linebuffer5_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width ) + i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width ) + i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width ) + i) },
                line3 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width ) + i) },
                line4 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width ) + i) }
            }

        } else if cur_lbuf_cnt == 1 {

            Linebuffer5_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width) + i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) },
                line3 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) },
                line4 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) }
            }
        } else if cur_lbuf_cnt == 2 {

            Linebuffer5_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((2 * img_dim.width) + i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width) + i) },
                line3 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) },
                line4 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((2 * img_dim.width) + i) }
            }

        } else if cur_lbuf_cnt == 3 {

            Linebuffer5_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((3 * img_dim.width) + i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((2 * img_dim.width) + i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) },
                line3 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width) + i) },
                line4 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) }
            }

        } else {

            Linebuffer5_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 1) % kernel_width) * img_dim.width + i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 2) % kernel_width) * img_dim.width + i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 3) % kernel_width) * img_dim.width + i) },
                line3 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 4) % kernel_width) * img_dim.width + i) },
                line4 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 0) % kernel_width) * img_dim.width + i) },
            }
        }
    }


    fn @prepare_lbuff5[T](input: &mut channel8[T], lbuff: &mut addrspace(3)[T], kernel_width: i32, img_dim: Img_dim) -> Linebuffer5_t[fn(i32) -> &mut addrspace(3) T] {
        let lbuf_seg = lbuf_cnt % kernel_width;

        for x in aie_pipeline(0, img_dim.width / v_size) {
            //let data_slice = read_channel_v8[T](input);
            let data_slice = cgra_read_channel_v8[T](input);
            let lbuff_idx = (lbuf_seg * img_dim.width) + (x * v_size);
            cgra_store_v_local[T](lbuff(lbuff_idx), data_slice);
        }

        let cur_lbuf_cnt = lbuf_cnt;
        lbuf_cnt++;

        if cur_lbuf_cnt == 0 {

            Linebuffer5_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width ) + i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width ) + i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width ) + i) },
                line3 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width ) + i) },
                line4 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width ) + i) }
            }

        } else if cur_lbuf_cnt == 1 {

            Linebuffer5_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width) + i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) },
                line3 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) },
                line4 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) }
            }
        } else if cur_lbuf_cnt == 2 {

            Linebuffer5_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((2 * img_dim.width) + i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width) + i) },
                line3 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) },
                line4 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((2 * img_dim.width) + i) }
            }

        } else if cur_lbuf_cnt == 3 {

            Linebuffer5_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((3 * img_dim.width) + i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((2 * img_dim.width) + i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) },
                line3 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((0 * img_dim.width) + i) },
                line4 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff((1 * img_dim.width) + i) }
            }

        } else {

            Linebuffer5_t[fn(i32) -> &mut addrspace(3) T] {
                line0 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 1) % kernel_width) * img_dim.width + i) },
                line1 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 2) % kernel_width) * img_dim.width + i) },
                line2 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 3) % kernel_width) * img_dim.width + i) },
                line3 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 4) % kernel_width) * img_dim.width + i) },
                line4 = @|i: i32| -> &mut addrspace(3) T { &mut lbuff(((cur_lbuf_cnt + 0) % kernel_width) * img_dim.width + i) },
            }
        }
    }


    fn process3[T](
        img_dim: Img_dim, linebuffer: Linebuffer_t[fn(i32) -> &mut addrspace(3) T], mask: Mask[DATA_TYPE], out: &mut channel8[DATA_TYPE]) -> () {

        //let ACC_SHIFT = 1:u32;
        let kernel_width = mask.size_x;
        let kernel_side = (kernel_width / 2) as u32;

        let mut line0_idx = 0;
        let mut line1_idx = 0;
        let mut line2_idx = 0;

        let mut acc: u64;

        let mut data_slice0 = cgra_zeros[DATA_TYPE](v_size as u32);
        let mut data_slice1 = cgra_zeros[DATA_TYPE](v_size as u32);
        let mut data_slice2 = cgra_zeros[DATA_TYPE](v_size as u32);

        let mut prev_slice0 = cgra_zeros[DATA_TYPE](v_size as u32);
        let mut prev_slice1 = cgra_zeros[DATA_TYPE](v_size as u32);
        let mut prev_slice2 = cgra_zeros[DATA_TYPE](v_size as u32);

        let points = next_8multiple(kernel_width as u32);
        let mut value = bitcast[[DATA_TYPE * 32]]([0; 32]);

        for j in range(0, mask.size_y) {
            for i in range(0, mask.size_x) {
                let idx = j * (points as i32) + i;
                value(idx) = mask.data(j, i);
            }
        }

        let mut coeffs_padded_row0 = cgra_zeros[DATA_TYPE](points);
        let mut coeffs_padded_row1 = cgra_zeros[DATA_TYPE](points);
        let mut coeffs_padded_row2 = cgra_zeros[DATA_TYPE](points);

        for x in aie_pipeline(0, (img_dim.width - (kernel_width - 1) + v_size - 1) / v_size) {

            coeffs_padded_row0 = cgra_load_v[DATA_TYPE](points, &value(0));
            coeffs_padded_row1 = cgra_load_v[DATA_TYPE](points, &value(0 + points));
            coeffs_padded_row2 = cgra_load_v[DATA_TYPE](points, &value(0 + (2 * points)));

            data_slice0 = cgra_load_v[DATA_TYPE](v_size as u32, bitcast[&DATA_TYPE](linebuffer.line0(line0_idx)));
            line0_idx += v_size;
            data_slice0 = cgra_shuffle_up_fill(data_slice0, copy_v(prev_slice0) , kernel_side);
            prev_slice0 = data_slice0;
            //prev_slice0 = copy_v(data_slice0);
            acc = sliding_mul_8x8_i32_fixed(coeffs_padded_row0, data_slice0);

            data_slice1 = cgra_load_v[DATA_TYPE](v_size as u32, bitcast[&DATA_TYPE](linebuffer.line1(line1_idx)));
            line1_idx += v_size;
            data_slice1 = cgra_shuffle_up_fill(data_slice1, prev_slice1, kernel_side);
            prev_slice1 = data_slice1;
            acc = sliding_mac_8x8_i32(acc, coeffs_padded_row1, data_slice1);

            data_slice2 = cgra_load_v[DATA_TYPE](v_size as u32, bitcast[&DATA_TYPE](linebuffer.line2(line2_idx)));
            line2_idx += v_size;
            data_slice2 = cgra_shuffle_up_fill(data_slice2, prev_slice2, kernel_side);
            prev_slice2 = data_slice2;
            acc = sliding_mac_8x8_i32(acc, coeffs_padded_row2, data_slice2);

            let res_vector = cgra_shift_round_saturate[DATA_TYPE, u64](v_size as u32, acc, ACC_SHIFT);
            cgra_window_write_channel_v8(out, res_vector);
            //write_channel8[i32](out, res_vector);
        }
    }


    fn process3_flat_window[T](
        img_dim: Img_dim, linebuffer: Linebuffer_t[fn(i32) -> &mut addrspace(3) T], mask: FlatMask3[DATA_TYPE], out: &mut channel8[DATA_TYPE]) -> () {

        // maybe still need to use copy()
        //let ACC_SHIFT = 1:u32;
        let kernel_width = mask.size;
        let kernel_side = (kernel_width / 2) as u32;

        let mut line0_idx = 0;
        let mut line1_idx = 0;
        let mut line2_idx = 0;

        let mut acc: u64;

        let mut data_slice0 = cgra_zeros[DATA_TYPE](v_size as u32);
        let mut data_slice1 = cgra_zeros[DATA_TYPE](v_size as u32);
        let mut data_slice2 = cgra_zeros[DATA_TYPE](v_size as u32);

        let mut prev_slice0 = cgra_zeros[DATA_TYPE](v_size as u32);
        let mut prev_slice1 = cgra_zeros[DATA_TYPE](v_size as u32);
        let mut prev_slice2 = cgra_zeros[DATA_TYPE](v_size as u32);

        let points = next_8multiple(kernel_width as u32);
       // let mut value = bitcast[[DATA_TYPE * 32]]([0; 32]);

       // for j in range(0, mask.size_y) {
       //     for i in range(0, mask.size_x) {
       //         let idx = j * (points as i32) + i;
       //         value(idx) = mask.data(j, i);
       //     }
       // }

       // let mut coeffs_padded_row0 = cgra_zeros[DATA_TYPE](points);
       // let mut coeffs_padded_row1 = cgra_zeros[DATA_TYPE](points);
       // let mut coeffs_padded_row2 = cgra_zeros[DATA_TYPE](points);

        for x in aie_pipeline(0, (img_dim.width - (kernel_width - 1) + v_size - 1) / v_size) {


            // loading 3 static arrays each with points=8 elements and already padded with zeros
            //let coeffs_padded_row0 = cgra_load_v[DATA_TYPE](points, &coeffs_row0(0));
            //let coeffs_padded_row1 = cgra_load_v[DATA_TYPE](points, &coeffs_row1(0));
            //let coeffs_padded_row2 = cgra_load_v[DATA_TYPE](points, &coeffs_row2(0));

           // let coeffs_padded_row0 = cgra_load_v[DATA_TYPE](points, &mask.row0(0));
           // let coeffs_padded_row1 = cgra_load_v[DATA_TYPE](points, &mask.row1(0));
           // let coeffs_padded_row2 = cgra_load_v[DATA_TYPE](points, &mask.row2(0));

            let coeffs_padded_row0 = cgra_load_v[DATA_TYPE](points, &promote_static(mask.row0)(0));
            let coeffs_padded_row1 = cgra_load_v[DATA_TYPE](points, &promote_static(mask.row1)(0));
            let coeffs_padded_row2 = cgra_load_v[DATA_TYPE](points, &promote_static(mask.row2)(0));


            //coeffs_padded_row0 = cgra_load_v[DATA_TYPE](points, &value(0));
            //coeffs_padded_row1 = cgra_load_v[DATA_TYPE](points, &value(0 + points));
            //coeffs_padded_row2 = cgra_load_v[DATA_TYPE](points, &value(0 + (2 * points)));

            data_slice0 = cgra_load_v[DATA_TYPE](v_size as u32, bitcast[&DATA_TYPE](linebuffer.line0(line0_idx)));
            line0_idx += v_size;
            data_slice0 = cgra_shuffle_up_fill(data_slice0, copy_v(prev_slice0) , kernel_side);
            prev_slice0 = data_slice0;
            //prev_slice0 = copy_v(data_slice0);
            acc = sliding_mul_8x8_i32_fixed(coeffs_padded_row0, data_slice0);

            data_slice1 = cgra_load_v[DATA_TYPE](v_size as u32, bitcast[&DATA_TYPE](linebuffer.line1(line1_idx)));
            line1_idx += v_size;
            data_slice1 = cgra_shuffle_up_fill(data_slice1, prev_slice1, kernel_side);
            prev_slice1 = data_slice1;
            acc = sliding_mac_8x8_i32(acc, coeffs_padded_row1, data_slice1);

            data_slice2 = cgra_load_v[DATA_TYPE](v_size as u32, bitcast[&DATA_TYPE](linebuffer.line2(line2_idx)));
            line2_idx += v_size;
            data_slice2 = cgra_shuffle_up_fill(data_slice2, prev_slice2, kernel_side);
            prev_slice2 = data_slice2;
            acc = sliding_mac_8x8_i32(acc, coeffs_padded_row2, data_slice2);

            let res_vector = cgra_shift_round_saturate[DATA_TYPE, u64](v_size as u32, acc, ACC_SHIFT);
            cgra_window_write_channel_v8(out, res_vector);
            //write_channel8[i32](out, res_vector);
        }
    }


    fn process3_flat_window_split2[T](
        img_dim: Img_dim, linebuffer: Linebuffer_t[fn(i32) -> &mut addrspace(3) T], mask: FlatMask3[DATA_TYPE], out1: &mut channel8[DATA_TYPE], out2: &mut channel8[DATA_TYPE]) -> () {


        // maybe still need to use copy()
        //let ACC_SHIFT = 1:u32;
        let kernel_width = mask.size;
        let kernel_side = (kernel_width / 2) as u32;

        let mut line0_idx = 0;
        let mut line1_idx = 0;
        let mut line2_idx = 0;

        let mut acc: u64;

        let mut data_slice0 = cgra_zeros[DATA_TYPE](v_size as u32);
        let mut data_slice1 = cgra_zeros[DATA_TYPE](v_size as u32);
        let mut data_slice2 = cgra_zeros[DATA_TYPE](v_size as u32);

        let mut prev_slice0 = cgra_zeros[DATA_TYPE](v_size as u32);
        let mut prev_slice1 = cgra_zeros[DATA_TYPE](v_size as u32);
        let mut prev_slice2 = cgra_zeros[DATA_TYPE](v_size as u32);

        let points = next_8multiple(kernel_width as u32);
       // let mut value = bitcast[[DATA_TYPE * 32]]([0; 32]);

       // for j in range(0, mask.size_y) {
       //     for i in range(0, mask.size_x) {
       //         let idx = j * (points as i32) + i;
       //         value(idx) = mask.data(j, i);
       //     }
       // }

       // let mut coeffs_padded_row0 = cgra_zeros[DATA_TYPE](points);
       // let mut coeffs_padded_row1 = cgra_zeros[DATA_TYPE](points);
       // let mut coeffs_padded_row2 = cgra_zeros[DATA_TYPE](points);

        for x in aie_pipeline(0, (img_dim.width - (kernel_width - 1) + v_size - 1) / v_size) {


            // loading 3 static arrays each with points=8 elements and already padded with zeros
            //let coeffs_padded_row0 = cgra_load_v[DATA_TYPE](points, &coeffs_row0(0));
            //let coeffs_padded_row1 = cgra_load_v[DATA_TYPE](points, &coeffs_row1(0));
            //let coeffs_padded_row2 = cgra_load_v[DATA_TYPE](points, &coeffs_row2(0));

           // let coeffs_padded_row0 = cgra_load_v[DATA_TYPE](points, &mask.row0(0));
           // let coeffs_padded_row1 = cgra_load_v[DATA_TYPE](points, &mask.row1(0));
           // let coeffs_padded_row2 = cgra_load_v[DATA_TYPE](points, &mask.row2(0));

            let coeffs_padded_row0 = cgra_load_v[DATA_TYPE](points, &promote_static(mask.row0)(0));
            let coeffs_padded_row1 = cgra_load_v[DATA_TYPE](points, &promote_static(mask.row1)(0));
            let coeffs_padded_row2 = cgra_load_v[DATA_TYPE](points, &promote_static(mask.row2)(0));


            //coeffs_padded_row0 = cgra_load_v[DATA_TYPE](points, &value(0));
            //coeffs_padded_row1 = cgra_load_v[DATA_TYPE](points, &value(0 + points));
            //coeffs_padded_row2 = cgra_load_v[DATA_TYPE](points, &value(0 + (2 * points)));

            data_slice0 = cgra_load_v[DATA_TYPE](v_size as u32, bitcast[&DATA_TYPE](linebuffer.line0(line0_idx)));
            line0_idx += v_size;
            data_slice0 = cgra_shuffle_up_fill(data_slice0, copy_v(prev_slice0) , kernel_side);
            prev_slice0 = data_slice0;
            //prev_slice0 = copy_v(data_slice0);
            acc = sliding_mul_8x8_i32_fixed(coeffs_padded_row0, data_slice0);

            data_slice1 = cgra_load_v[DATA_TYPE](v_size as u32, bitcast[&DATA_TYPE](linebuffer.line1(line1_idx)));
            line1_idx += v_size;
            data_slice1 = cgra_shuffle_up_fill(data_slice1, prev_slice1, kernel_side);
            prev_slice1 = data_slice1;
            acc = sliding_mac_8x8_i32(acc, coeffs_padded_row1, data_slice1);

            data_slice2 = cgra_load_v[DATA_TYPE](v_size as u32, bitcast[&DATA_TYPE](linebuffer.line2(line2_idx)));
            line2_idx += v_size;
            data_slice2 = cgra_shuffle_up_fill(data_slice2, prev_slice2, kernel_side);
            prev_slice2 = data_slice2;
            acc = sliding_mac_8x8_i32(acc, coeffs_padded_row2, data_slice2);

            let res_vector = cgra_shift_round_saturate[DATA_TYPE, u64](v_size as u32, acc, ACC_SHIFT);
            cgra_window_write_channel_v8(out1, res_vector);
            cgra_window_write_channel_v8(out2, res_vector);
            //write_channel8[i32](out, res_vector);
        }
    }


