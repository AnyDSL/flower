shi_thomasi_aie_split/main.cpp.i:
	cd /home/puya/Projects/flower_anydsl/build && $(MAKE) $(MAKESILENT) -f apps/CMakeFiles/shi_thomasi_aie_split.dir/build.make apps/CMakeFiles/shi_thomasi_aie_split.dir/shi_thomasi_aie_split/main.cpp.i
.PHONY : shi_thomasi_aie_split/main.cpp.i

shi_thomasi_aie_split/main.s: shi_thomasi_aie_split/main.cpp.s
.PHONY : shi_thomasi_aie_split/main.s

